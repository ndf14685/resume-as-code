#!/usr/bin/env bash
# Convenience wrapper: runs the CLI from the project's virtualenv without an
# install step. Works from the repo root: ./resume generate --profile devops
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$ROOT/.venv/bin/python"
if [[ ! -x "$PY" ]]; then
  PY="$(command -v python3)"
fi
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m resume_as_code.cli "$@"
